#!/usr/bin/env bash
# muxa — tmux-native messaging for AI agent CLIs.
# bash 3.2+ (macOS / Linux). Requires tmux. python3 used for JSON and spawn quoting.
set -euo pipefail

VERSION=0.3.0
TMUX_BIN="${MUXA_TMUX_BIN:-tmux}"

usage() {
  cat <<'EOF'
muxa — message other AI CLIs in this tmux server

  muxa register [--name NAME] [--id ID] [--parent NAME] [--kind claude|cursor|pi|generic]
  muxa spawn [--name NAME] [--kind KIND] [--cwd DIR] [--split] [--window] -- COMMAND...
                                spawn flags must precede -- or the command word
                                omit --name to get a unique adjective-noun alias (swift-oak)
                                default: split into a tiled grid in this window (--window for a new window)
                                child cwd: --cwd, else process PWD, else this pane's path
                                warns on stderr if a live registered worker already has that cwd
  muxa who [--json]                 roster (tmux pane options, cwd, STATUS; STATE from broker drawing)
  muxa whoami                       this pane's alias
  muxa unregister NAME|ID           clear muxa registration; leave pane running
  muxa id                           this pane's unique muxa id
  muxa session                      empty (CLI session id is not tracked)
  muxa parent                       this pane's parent alias (empty if root)
  muxa children                     direct children of this pane
  muxa tail NAME [-n N]             one-shot pane capture (visible; -n last N lines of history)
  muxa send [--json] [--no-reply] NAME TEXT  enqueue on the pane-mail broker (parent↔child only)
  muxa send [--json] --all TEXT     every parent/child pane (not siblings or other roots)
  muxa broker [start|status|stop]   user-level paste broker (unix socket + file queue)
  muxa hook session-start [--kind KIND]
                                optional root self-registration; spawned panes are already registered
  muxa version

Reachability: a parent may message its children; a child may message its
parent. Children cannot message each other. Roots (no parent) cannot
message other roots. muxa send --all follows the same rule.

Agents send with Bash. Incoming mail arrives as a user turn.
Do not poll an inbox. Do not add MCP tools.
EOF
}

die() { printf 'muxa: %s\n' "$*" >&2; exit 2; }
forbid() { printf 'muxa: %s\n' "$*" >&2; exit 4; }

need_tmux() {
  [ -n "${TMUX:-}" ] || [ -n "${MUXA_TMUX_SOCKET:-}" ] || { printf 'muxa: not in tmux (hard requirement)\n' >&2; exit 3; }
}

tmux_do() {
  if [ -n "${MUXA_TMUX_SOCKET:-}" ]; then
    "$TMUX_BIN" -L "$MUXA_TMUX_SOCKET" "$@"
  else
    "$TMUX_BIN" "$@"
  fi
}

runtime_root() {
  local base pid
  base="${XDG_RUNTIME_DIR:-/tmp/muxa-${UID:-$(id -u)}}"
  pid="$(tmux_do list-sessions -F '#{pid}' 2>/dev/null | head -1)"
  [ -n "$pid" ] || pid=0
  printf '%s/muxa/%s' "$base" "$pid"
}

this_pane() {
  if [ -n "${TMUX_PANE:-}" ]; then
    printf '%s' "$TMUX_PANE"
    return
  fi
  tmux_do display-message -p '#{pane_id}' 2>/dev/null || die "cannot detect pane; set TMUX_PANE"
}

pane_fmt() {
  tmux_do display-message -t "$1" -p "$2" 2>/dev/null || true
}

# ceil(sqrt(n)) for a positive integer. Used to size the next grid.
ceil_sqrt() {
  local n="$1" i=1
  [ "$n" -gt 0 ] || { printf '1'; return; }
  while [ $((i * i)) -lt "$n" ]; do
    i=$((i + 1))
  done
  printf '%s' "$i"
}

# Largest pane (by area, then rightmost) in the last row of the window
# containing $1. Last row = maximum #{pane_top}.
grid_split_target() {
  local win="$1" id top left w h area
  local max_top=-1 best_id="" best_area=-1 best_left=-1
  while read -r id top left w h; do
    [ -n "$id" ] && [ -n "$top" ] && [ -n "$left" ] && [ -n "$w" ] && [ -n "$h" ] || continue
    area=$((w * h))
    if [ "$top" -gt "$max_top" ]; then
      max_top=$top
      best_id=$id
      best_area=$area
      best_left=$left
    elif [ "$top" -eq "$max_top" ]; then
      if [ "$area" -gt "$best_area" ] || { [ "$area" -eq "$best_area" ] && [ "$left" -gt "$best_left" ]; }; then
        best_id=$id
        best_area=$area
        best_left=$left
      fi
    fi
  done <<EOF
$(tmux_do list-panes -t "$win" -F '#{pane_id} #{pane_top} #{pane_left} #{pane_width} #{pane_height}')
EOF
  printf '%s' "$best_id"
}

set_pane_opt() {
  tmux_do set-option -p -t "$1" "$2" "$3"
}

unset_pane_opt() {
  tmux_do set-option -p -t "$1" -u "$2" 2>/dev/null || true
}

new_muxa_id() {
  python3 -c 'import uuid; print(uuid.uuid4().hex[:12])'
}

# pane_id  name  id  parent  kind  where  cwd  command
# tmux <=3.4 rewrites literal tab bytes in -F output to "_", which breaks
# tab-delimited parsing on some platforms (e.g. Ubuntu CI runners). "||"
# survives unmodified and won't appear in any of these fields in practice.
roster_lines() {
  tmux_do list-panes -a -F '#{pane_id}||#{@muxa_name}||#{@muxa_id}||#{@muxa_parent}||#{@muxa_kind}||#{session_name}:#{window_index}.#{pane_index}||#{pane_current_path}||#{pane_current_command}' 2>/dev/null \
    | awk -F '\\|\\|' '$2 != "" { print }'
}

is_shell_command() {
  local base
  base="$(basename "$1")"
  case "$base" in
    zsh|bash|fish|sh|dash|ksh) return 0 ;;
    *) return 1 ;;
  esac
}

pane_status() {
  local kind="$1" cwd="$2" cmd="$3"
  if [ -n "$cwd" ] && [ ! -d "$cwd" ]; then
    printf 'ghost'
    return
  fi
  case "$kind" in
    claude|cursor|pi)
      if is_shell_command "$cmd"; then
        printf 'ghost'
        return
      fi
      ;;
  esac
  printf 'live'
}

# Overlay control-mode drawing onto a live status. Ghost stays ghost: a
# missing cwd is not "drawing". Occupancy still uses pane_status.
pane_who_status() {
  local st pane drawing
  st="$(pane_status "$1" "$2" "$3")"
  pane="$4"
  drawing="$5"
  if [ "$st" = "live" ] && [ -n "$pane" ]; then
    case " $drawing " in
      *" $pane "*) st=drawing ;;
    esac
  fi
  printf '%s' "$st"
}

# STATE is the broker's drawing list, not a hook-written pane option.
# drawing → busy; otherwise idle. blocked is gone: nothing observes it.
pane_who_state() {
  local pane="$1" drawing="$2"
  case " $drawing " in
    *" $pane "*) printf 'busy' ;;
    *) printf 'idle' ;;
  esac
}

# Best-effort: never start a broker, never fail who. Empty if the socket is down.
broker_drawing_ids() {
  [ -n "${BROKER_SOCK:-}" ] || broker_setup_paths
  [ -S "${BROKER_SOCK:-}" ] || return 0
  python3 -c '
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(0.2)
try:
    s.connect(sys.argv[1])
    s.sendall(b"{\"op\":\"status\"}\n")
    s.shutdown(socket.SHUT_WR)
    data = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        data += chunk
    resp = json.loads(data.decode() or "{}")
except Exception:
    sys.exit(0)
if not resp.get("ok"):
    sys.exit(0)
print(" ".join(resp.get("drawing") or []))
' "$BROKER_SOCK" 2>/dev/null || true
}

clear_muxa_registration() {
  local pane="$1"
  unset_pane_opt "$pane" @muxa_name
  unset_pane_opt "$pane" @muxa_id
  unset_pane_opt "$pane" @muxa_parent
  unset_pane_opt "$pane" @muxa_kind
  unset_pane_opt "$pane" @muxa_state
  unset_pane_opt "$pane" @muxa_deliver
  unset_pane_opt "$pane" @muxa_session
  unset_pane_opt "$pane" @muxa_hook_ok
  unset_pane_opt "$pane" @muxa_unread
  unset_pane_opt "$pane" @muxa_kick_wait
  unset_pane_opt "$pane" @muxa_stop_pending
  unset_pane_opt "$pane" @muxa_stop_pending_batch
  set_pane_title "$pane" ""
}

find_pane_by_target() {
  local target="$1" line
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 2)" = "$target" ] || continue
    printf '%s' "$(printf '%s\n' "$line" | field 1)"
    return 0
  done <<EOF
$(roster_lines)
EOF
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 3)" = "$target" ] || continue
    printf '%s' "$(printf '%s\n' "$line" | field 1)"
    return 0
  done <<EOF
$(roster_lines)
EOF
  return 1
}

field() {
  awk -F '\\|\\|' -v n="$1" '{ print $n }'
}

find_pane_by_name() {
  local name="$1" line
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 2)" = "$name" ] || continue
    printf '%s' "$(printf '%s\n' "$line" | field 1)"
    return 0
  done <<EOF
$(roster_lines)
EOF
  return 1
}

pane_is_registered() {
  [ -n "$1" ] && [ -n "$(pane_fmt "$1" '#{@muxa_name}')" ]
}

name_parent() {
  local pane
  pane="$(find_pane_by_name "$1")" || { printf ''; return 0; }
  pane_fmt "$pane" '#{@muxa_parent}'
}

name_taken_by_other() {
  local name="$1" self="$2" line pane
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 2)" = "$name" ] || continue
    pane="$(printf '%s\n' "$line" | field 1)"
    if [ "$pane" != "$self" ]; then
      return 0
    fi
  done <<EOF
$(roster_lines)
EOF
  return 1
}

# Parent may talk to its children. Child may talk to its parent.
# Children cannot talk to each other. Roots cannot talk to other roots.
can_send() {
  local from="$1" to="$2"
  local from_parent to_parent
  [ -n "$from" ] && [ -n "$to" ] || return 1
  [ "$from" != "$to" ] || return 1
  from_parent="$(name_parent "$from")"
  to_parent="$(name_parent "$to")"
  if [ "$to_parent" = "$from" ]; then
    return 0
  fi
  if [ "$from_parent" = "$to" ]; then
    return 0
  fi
  return 1
}

pane_command_line() {
  local pane="$1" pid line
  pid="$(pane_fmt "$pane" '#{pane_pid}')"
  [ -n "$pid" ] || return 1
  if [ -r "/proc/$pid/cmdline" ]; then
    line="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | sed 's/[[:space:]]*$//')"
    if [ -n "$line" ]; then
      printf '%s' "$line"
      return 0
    fi
  fi
  line="$(ps -p "$pid" -o args= 2>/dev/null | head -1)" || \
    line="$(ps -p "$pid" -o command= 2>/dev/null | head -1)" || return 1
  line="${line#"${line%%[![:space:]]*}"}"
  [ -n "$line" ] && printf '%s' "$line"
}

# Classify a CLI from a spawn argument (muxa spawn -- CMD …).
kind_from_command() {
  kind_from_argv "$1"
}

# Classify from a full process command line (ps). Match executable basenames
# and anchored path segments — not bare substrings like "omp" in compose
# or "claude" in claude-projects.
kind_from_argv() {
  local line="$1" tok base rest
  case "$line" in
    *cursor-agent*) printf 'cursor'; return ;;
  esac
  tok="${line%% *}"
  base="${tok##*/}"
  case "$base" in
    claude*) printf 'claude'; return ;;
    agent|cursor-agent) printf 'cursor'; return ;;
    omp|pi) printf 'pi'; return ;;
  esac
  rest="${line#"$tok"}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  case "$rest" in
    *cursor-agent*) printf 'cursor'; return ;;
    *"/claude/"*|*"/claude-code"*|*"/claude-code/"*) printf 'claude'; return ;;
  esac
  case "$line" in
    *"/agent "*|*" agent "*|*" agent"|agent\ *) printf 'cursor'; return ;;
  esac
  printf 'generic'
}

detect_kind() {
  local pane="$1" cmd args
  cmd="$(pane_fmt "$pane" '#{pane_current_command}')"
  case "$cmd" in
    claude*) printf 'claude'; return ;;
    agent|cursor-agent) printf 'cursor'; return ;;
    omp|pi) printf 'pi'; return ;;
  esac
  args="$(pane_command_line "$pane" 2>/dev/null || true)"
  if [ -n "$args" ]; then
    kind_from_argv "$args"
    return
  fi
  printf 'generic'
}

sanitize_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'
}

# Two-syllable-ish words; pairs pass sanitize_name and are easy to say/type.
MUXA_NAME_ADJECTIVES='amber azure bold brave bright calm crisp eager fair gentle golden keen lively lucid lunar merry noble proud quiet rustic silent silver solar sturdy swift vivid'
MUXA_NAME_NOUNS='badger brook canyon cedar comet ember falcon fern fox glacier grove harbor hawk heron lark maple meadow oak otter pebble pine raven ridge river sparrow stone willow wolf'

word_from_list() {
  local list="$1" n i idx=0 w
  # shellcheck disable=SC2086
  set -- $list
  n=$#
  [ "$n" -gt 0 ] || return 1
  i=$((RANDOM % n))
  for w in "$@"; do
    if [ "$idx" -eq "$i" ]; then
      printf '%s' "$w"
      return 0
    fi
    idx=$((idx + 1))
  done
}

# Unique adjective-noun for this tmux roster. $1 = pane to ignore (self), if any.
generate_unique_name() {
  local self="${1:-}" tries=0 adj noun candidate suffix
  while [ "$tries" -lt 64 ]; do
    adj="$(word_from_list "$MUXA_NAME_ADJECTIVES")"
    noun="$(word_from_list "$MUXA_NAME_NOUNS")"
    candidate="$(sanitize_name "$adj-$noun")"
    if [ -n "$candidate" ] && ! name_taken_by_other "$candidate" "$self"; then
      printf '%s' "$candidate"
      return 0
    fi
    tries=$((tries + 1))
  done
  adj="$(word_from_list "$MUXA_NAME_ADJECTIVES")"
  noun="$(word_from_list "$MUXA_NAME_NOUNS")"
  suffix=2
  candidate="$(sanitize_name "$adj-$noun-$suffix")"
  while name_taken_by_other "$candidate" "$self"; do
    suffix=$((suffix + 1))
    candidate="$(sanitize_name "$adj-$noun-$suffix")"
  done
  printf '%s' "$candidate"
}

set_pane_title() {
  tmux_do select-pane -t "$1" -T "$2" 2>/dev/null || true
}

default_name() {
  local pane="$1" existing
  if [ -n "${MUXA_NAME:-}" ]; then
    sanitize_name "$MUXA_NAME"
    return
  fi
  existing="$(pane_fmt "$pane" '#{@muxa_name}')"
  if [ -n "$existing" ]; then
    printf '%s' "$existing"
    return
  fi
  generate_unique_name "$pane"
}

parent_would_cycle() {
  local child="$1" parent="$2" walk
  [ -n "$parent" ] || return 1
  [ "$child" != "$parent" ] || return 0
  walk="$parent"
  while [ -n "$walk" ]; do
    [ "$walk" != "$child" ] || return 0
    walk="$(name_parent "$walk")"
  done
  return 1
}

shlex_join() {
  python3 -c 'import shlex, sys; print(shlex.join(sys.argv[1:]))' "$@"
}

format_one() {
  local from="$1" flags="$2" body="$3"
  printf '[muxa] from=%s\n' "$from"
  printf '%s\n' "$body"
  case " $flags " in
    *" no-reply "*) printf 'Do not reply.\n' ;;
    *) printf 'Reply: muxa send %s "…"  (skip acks unless asked)\n' "$from" ;;
  esac
}

cmd_register() {
  need_tmux
  local pane name kind parent id
  pane="$(this_pane)"
  name=""
  kind=""
  parent=""
  id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --kind) kind="$2"; shift 2 ;;
      --parent) parent="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      *) die "register: unknown arg $1" ;;
    esac
  done
  [ -n "$name" ] || name="$(default_name "$pane")"
  [ -n "$name" ] || die "could not derive a name; pass --name"
  [ -n "$kind" ] || kind="$(detect_kind "$pane")"
  [ -n "$parent" ] || parent="${MUXA_PARENT:-}"
  [ -n "$parent" ] || parent="$(pane_fmt "$pane" '#{@muxa_parent}')"
  [ -n "$id" ] || id="${MUXA_ID:-}"
  [ -n "$id" ] || id="$(pane_fmt "$pane" '#{@muxa_id}')"
  [ -n "$id" ] || id="$(new_muxa_id)"
  case "$kind" in claude|cursor|pi|generic) ;; *) die "bad kind $kind" ;; esac
  if name_taken_by_other "$name" "$pane"; then
    die "name '$name' already registered on another pane"
  fi
  if [ -n "$parent" ]; then
    if [ "$parent" = "$name" ]; then
      die "parent cannot be self"
    fi
    find_pane_by_name "$parent" >/dev/null || die "unknown parent '$parent'"
    if parent_would_cycle "$name" "$parent"; then
      die "parent '$parent' would create a cycle"
    fi
  fi
  set_pane_opt "$pane" @muxa_name "$name"
  set_pane_opt "$pane" @muxa_id "$id"
  set_pane_opt "$pane" @muxa_kind "$kind"
  if [ -n "$parent" ]; then
    set_pane_opt "$pane" @muxa_parent "$parent"
  else
    unset_pane_opt "$pane" @muxa_parent
  fi
  set_pane_title "$pane" "$name"
  if [ -n "$parent" ]; then
    printf 'registered %s id=%s parent=%s kind=%s pane=%s\n' \
      "$name" "$id" "$parent" "$kind" "$pane"
  else
    printf 'registered %s id=%s parent=- kind=%s pane=%s\n' \
      "$name" "$id" "$kind" "$pane"
  fi
}

cmd_who_json() {
  local line kind cwd cmd status state pane drawing
  drawing="$(broker_drawing_ids)"
  {
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      pane="$(printf '%s\n' "$line" | field 1)"
      kind="$(printf '%s\n' "$line" | field 5)"
      cwd="$(printf '%s\n' "$line" | field 7)"
      cmd="$(printf '%s\n' "$line" | field 8)"
      status="$(pane_who_status "$kind" "$cwd" "$cmd" "$pane" "$drawing")"
      state="$(pane_who_state "$pane" "$drawing")"
      printf '%s||%s||%s\n' "$line" "$status" "$state"
    done <<EOF
$(roster_lines)
EOF
  } | python3 -c '
import json, sys

def n(s):
    return s if s else None

rows = []
for raw in sys.stdin:
    raw = raw.rstrip("\n")
    if not raw:
        continue
    p = raw.split("||")
    p.extend([""] * (10 - len(p)))
    rows.append({
        "name": p[1],
        "id": p[2],
        "parent": n(p[3]),
        "kind": p[4],
        "state": p[9],
        "pane": p[0],
        "session": None,
        "cwd": p[6],
        "status": p[8],
    })
json.dump(rows, sys.stdout, separators=(",", ":"), ensure_ascii=False)
sys.stdout.write("\n")
'
}

cmd_who() {
  need_tmux
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "who: unknown flag $1" ;;
      *) die "who: unexpected argument $1" ;;
    esac
  done
  if [ "$json" -eq 1 ]; then
    cmd_who_json
    return
  fi
  printf '%-16s %-14s %-36s %-16s %-8s %-8s %-8s %-8s %-16s %s\n' \
    NAME ID SESSION PARENT KIND STATE STATUS PANE WHERE CWD
  local line kind cwd cmd status state name pane drawing
  drawing="$(broker_drawing_ids)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    pane="$(printf '%s\n' "$line" | field 1)"
    kind="$(printf '%s\n' "$line" | field 5)"
    cwd="$(printf '%s\n' "$line" | field 7)"
    cmd="$(printf '%s\n' "$line" | field 8)"
    status="$(pane_who_status "$kind" "$cwd" "$cmd" "$pane" "$drawing")"
    state="$(pane_who_state "$pane" "$drawing")"
    name="$(printf '%s\n' "$line" | field 2)"
    printf '%-16s %-14s %-36s %-16s %-8s %-8s %-8s %-8s %-16s %s\n' \
      "$name" \
      "$(printf '%s\n' "$line" | field 3)" \
      "" \
      "$(printf '%s\n' "$line" | field 4)" \
      "$kind" \
      "$state" \
      "$status" \
      "$(printf '%s\n' "$line" | field 1)" \
      "$(printf '%s\n' "$line" | field 6)" \
      "$cwd"
  done <<EOF
$(roster_lines)
EOF
}

# One-shot pane read. Default is the visible grid (capture-pane -p).
# -n N is last N lines of history+visible — a read, never a poll.
cmd_tail() {
  need_tmux
  local name="" n="" pane
  while [ $# -gt 0 ]; do
    case "$1" in
      -n)
        [ $# -ge 2 ] || die "tail: -n requires a line count"
        n="$2"
        shift 2
        ;;
      -n*)
        n="${1#-n}"
        [ -n "$n" ] || die "tail: -n requires a line count"
        shift
        ;;
      --) shift; break ;;
      -*) die "tail: unknown flag $1" ;;
      *)
        [ -z "$name" ] || die "tail: unexpected argument $1"
        name="$1"
        shift
        ;;
    esac
  done
  [ $# -eq 0 ] || die "tail: unexpected argument $1"
  [ -n "$name" ] || die "tail: NAME required"
  if [ -n "$n" ]; then
    case "$n" in
      *[!0-9]*|0) die "tail: -n must be a positive integer" ;;
    esac
  fi
  pane="$(find_pane_by_name "$name")" || die "unknown agent '$name' — muxa who"
  if [ -n "$n" ]; then
    # History includes the unused blank rows at the bottom of the grid.
    # Strip those, then take the last N content lines — a read, not a poll.
    tmux_do capture-pane -p -S - -t "$pane" | python3 -c '
import sys
n = int(sys.argv[1])
lines = sys.stdin.read().splitlines()
while lines and lines[-1] == "":
    lines.pop()
for line in lines[-n:]:
    sys.stdout.write(line + "\n")
' "$n" || die "tail: could not read pane $pane"
  else
    tmux_do capture-pane -p -t "$pane" || die "tail: could not read pane $pane"
  fi
}

cmd_unregister() {
  need_tmux
  local target="${1:-}" pane name id
  [ -n "$target" ] || die "unregister: NAME or ID required"
  pane="$(find_pane_by_target "$target")" || die "unknown agent '$target' — muxa who"
  name="$(pane_fmt "$pane" '#{@muxa_name}')"
  id="$(pane_fmt "$pane" '#{@muxa_id}')"
  clear_muxa_registration "$pane"
  printf 'unregistered %s id=%s pane=%s\n' "$name" "$id" "$pane"
}

cmd_whoami() {
  need_tmux
  local n
  n="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$n" ] || die "this pane is not registered (muxa register)"
  printf '%s\n' "$n"
}

cmd_id() {
  need_tmux
  local n
  n="$(pane_fmt "$(this_pane)" '#{@muxa_id}')"
  [ -n "$n" ] || die "this pane is not registered (muxa register)"
  printf '%s\n' "$n"
}

cmd_session() {
  need_tmux
  printf '\n'
}

cmd_parent() {
  need_tmux
  printf '%s\n' "$(pane_fmt "$(this_pane)" '#{@muxa_parent}')"
}

cmd_children() {
  need_tmux
  local me line
  me="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$me" ] || die "this pane is not registered (muxa register)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "$(printf '%s\n' "$line" | field 4)" = "$me" ]; then
      printf '%s\n' "$(printf '%s\n' "$line" | field 2)"
    fi
  done <<EOF
$(roster_lines)
EOF
}

broker_bin_path() {
  if [ -n "${MUXA_BROKER_BIN:-}" ]; then
    printf '%s' "$MUXA_BROKER_BIN"
    return
  fi
  python3 -c 'import os,sys; print(os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "muxa-broker"))' "${BASH_SOURCE[0]}"
}

broker_setup_paths() {
  local rt
  rt="$(runtime_root)"
  BROKER_DIR="${MUXA_BROKER_DIR:-$rt/broker}"
  BROKER_SOCK="${MUXA_BROKER_SOCK:-$BROKER_DIR/broker.sock}"
  BROKER_PID="${MUXA_BROKER_PID:-$BROKER_DIR/broker.pid}"
}

broker_ping() {
  [ -n "${BROKER_SOCK:-}" ] || broker_setup_paths
  [ -S "$BROKER_SOCK" ] || return 1
  python3 -c '
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(0.5)
try:
    s.connect(sys.argv[1])
    s.sendall(b"{\"op\":\"ping\"}\n")
    s.shutdown(socket.SHUT_WR)
    data = s.recv(4096)
except Exception:
    sys.exit(1)
try:
    resp = json.loads(data.decode() or "{}")
except Exception:
    sys.exit(1)
sys.exit(0 if resp.get("ok") else 1)
' "$BROKER_SOCK"
}

# Auto-start a user-level broker if the socket is dead. Pidfile + socket only;
# keep this small.
#
# muxa-broker re-execs itself with setsid(2) and writes its own pidfile, so the
# daemon lives in a session of its own. That is the part that matters: nohup and
# disown only detach the job from this shell's table, they leave the child in
# this shell's process group, and one group-directed signal when the caller's
# tool call ends then kills the broker before it delivers anything. macOS has no
# setsid(1), so the escape has to come from the binary. Do not write $! here —
# it is the forking parent, which exits in milliseconds.
ensure_broker() {
  local bin i lock runbin held=0 rc=1
  if [ "${MUXA_BROKER:-1}" = "0" ]; then
    return 1
  fi
  broker_setup_paths
  mkdir -p "$BROKER_DIR" || return 1
  broker_ping && return 0
  bin="$(broker_bin_path)"
  [ -x "$bin" ] || return 1
  lock="$BROKER_DIR/start.lock"
  # A lock whose starter was killed before it could rmdir must not wedge every
  # later start — that turns one lost broker into permanently failing sends.
  if [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
    rmdir "$lock" 2>/dev/null || true
  fi
  if mkdir "$lock" 2>/dev/null; then
    held=1
    runbin="$BROKER_DIR/muxa-broker"
    if ! cp "$bin" "$runbin"; then
      rmdir "$lock" 2>/dev/null || true
      return 1
    fi
    chmod +x "$runbin"
    # darwin 25+ SIGKILLs provenance-tagged worktree binaries; sign the copy.
    if [ "$(uname -s)" = Darwin ]; then
      xattr -c "$runbin" 2>/dev/null || true
      codesign -s - --force --timestamp=none "$runbin" 2>/dev/null || true
    fi
    rm -f "$BROKER_SOCK" "$BROKER_PID"
    # Still backgrounded, even though the binary now forks its own daemon:
    # bin/muxa-broker is gitignored and versioned separately from this script,
    # so a checkout can pair a new muxa with an older broker that runs in the
    # foreground forever. Backgrounding costs nothing — the poll below is what
    # makes this synchronous — and it keeps that pairing from hanging every
    # send. Force the fork on: an inherited MUXA_BROKER_FOREGROUND would stop
    # a current binary from detaching at all.
    MUXA_BROKER_DIR="$BROKER_DIR" \
    MUXA_BROKER_SOCK="$BROKER_SOCK" \
    MUXA_BROKER_PID="$BROKER_PID" \
    MUXA_BROKER_FOREGROUND=0 \
    MUXA_BROKER_DAEMONIZED=0 \
      nohup "$runbin" >>"$BROKER_DIR/broker.log" 2>&1 &
    disown 2>/dev/null || true
  fi
  # Hold the lock across the wait, not just the launch. The daemon re-execs
  # with setsid and only binds the socket a moment later; releasing at launch
  # leaves a gap in which a second starter takes the lock, deletes
  # broker.sock/broker.pid out from under the daemon coming up, and runs a
  # second one against the same MUXA_BROKER_DIR — two owners polling one
  # pending/. A starter that did not get the lock never touches those files;
  # it only waits for whoever holds it. muxa-broker also flocks the queue, so
  # a bypassed lock still cannot produce a second owner.
  i=0
  while [ "$i" -lt 120 ]; do
    if broker_ping; then
      rc=0
      break
    fi
    sleep 0.05
    i=$((i + 1))
  done
  if [ "$held" -eq 1 ]; then
    rmdir "$lock" 2>/dev/null || true
  fi
  return "$rc"
}

broker_enqueue() {
  local id="$1" pane="$2" from="$3" to="$4" text="$5"
  [ -n "${BROKER_SOCK:-}" ] || broker_setup_paths
  python3 - "$BROKER_SOCK" "$id" "$pane" "$from" "$to" "$text" <<'PY'
import json, socket, sys
sockpath, mid, pane, frm, to, text = sys.argv[1:7]
req = {"op": "enqueue", "id": mid, "pane": pane, "from": frm, "to": to, "text": text}
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
s.connect(sockpath)
s.sendall(json.dumps(req).encode() + b"\n")
s.shutdown(socket.SHUT_WR)
data = b""
while True:
    chunk = s.recv(65536)
    if not chunk:
        break
    data += chunk
try:
    resp = json.loads(data.decode() or "{}")
except Exception:
    sys.stderr.write("muxa: broker: bad response\n")
    sys.exit(1)
if not resp.get("ok"):
    sys.stderr.write("muxa: broker: %s\n" % (resp.get("error") or "enqueue failed"))
    sys.exit(1)
PY
}

cmd_broker() {
  local sub="${1:-start}" pid
  shift || true
  need_tmux
  broker_setup_paths
  case "$sub" in
    start)
      if [ "${MUXA_BROKER:-1}" = "0" ]; then
        die "broker is required (MUXA_BROKER=0 is not supported)"
      fi
      if ensure_broker; then
        pid="$(cat "$BROKER_PID" 2>/dev/null || printf '?')"
        printf 'broker pid=%s sock=%s dir=%s\n' "$pid" "$BROKER_SOCK" "$BROKER_DIR"
      else
        die "could not start broker (build bin/muxa-broker)"
      fi
      ;;
    status)
      if broker_ping; then
        python3 -c '
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(2)
s.connect(sys.argv[1])
s.sendall(b"{\"op\":\"status\"}\n")
s.shutdown(socket.SHUT_WR)
data = b""
while True:
    chunk = s.recv(65536)
    if not chunk:
        break
    data += chunk
sys.stdout.write(data.decode())
' "$BROKER_SOCK"
      else
        printf 'broker down sock=%s\n' "$BROKER_SOCK"
        return 1
      fi
      ;;
    stop)
      pid="$(cat "$BROKER_PID" 2>/dev/null || true)"
      if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
      fi
      rm -f "$BROKER_PID" "$BROKER_SOCK"
      printf 'stopped broker pid=%s\n' "${pid:-none}"
      ;;
    *) die "broker: start|status|stop" ;;
  esac
}

# Enqueue on muxa-broker. Fail closed: no paste-buffer fallback, no maildir.
# SEND_JSON=1 prints {id,pane,from,to} instead of the human queued line.
send_one() {
  local from="$1" to="$2" flags="$3" body="$4"
  local pane id text
  if [ "$to" = "$from" ]; then
    return 0
  fi
  pane="$(find_pane_by_name "$to")" || die "unknown agent '$to' — muxa who"
  can_send "$from" "$to" || forbid "forbidden $from → $to (only parent↔child)"
  if [ "${MUXA_BROKER:-1}" = "0" ]; then
    die "broker is required (MUXA_BROKER=0 is not supported)"
  fi
  text="$(format_one "$from" "$flags" "$body")"
  id="$(date +%s)-$$-$(printf '%05d' "$RANDOM")"
  ensure_broker || die "broker unreachable (could not start muxa-broker)"
  broker_enqueue "$id" "$pane" "$from" "$to" "$text" || die "broker enqueue failed"
  if [ "${SEND_JSON:-0}" -eq 1 ]; then
    python3 -c 'import json,sys; print(json.dumps({"id":sys.argv[1],"pane":sys.argv[2],"from":sys.argv[3],"to":sys.argv[4]}, separators=(",", ":"), ensure_ascii=False))' \
      "$id" "$pane" "$from" "$to"
  else
    printf 'queued %s → %s id=%s (broker)\n' "$from" "$to" "$id"
  fi
}

cmd_send() {
  need_tmux
  local no_reply=0 all=0 json=0 to="" body="" from flags line dest n item
  local all_json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-reply) no_reply=1; shift ;;
      --all) all=1; shift ;;
      --json) json=1; shift ;;
      --) shift; break ;;
      -*) die "send: unknown flag $1" ;;
      *) break ;;
    esac
  done
  if [ "$all" -eq 0 ]; then
    [ $# -ge 1 ] || die "send: NAME required"
    to="$1"
    shift
  fi
  if [ $# -gt 0 ]; then
    body="$*"
  else
    body="$(cat)"
  fi
  [ -n "$body" ] || die "send: empty body"
  from="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$from" ] || from="${MUXA_NAME:-human}"
  flags=""
  [ "$no_reply" -eq 1 ] && flags="no-reply"
  SEND_JSON="$json"

  if [ "$all" -eq 1 ]; then
    n=0
    seen=$'\n'
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      dest="$(printf '%s\n' "$line" | field 2)"
      [ -n "$dest" ] || continue
      case "$seen" in
        *$'\n'"$dest"$'\n'*) continue ;;
      esac
      can_send "$from" "$dest" || continue
      seen="${seen}${dest}"$'\n'
      if [ "$json" -eq 1 ]; then
        item="$(send_one "$from" "$dest" "$flags" "$body")"
        all_json="${all_json}${item}"$'\n'
      else
        send_one "$from" "$dest" "$flags" "$body"
      fi
      n=$((n + 1))
    done <<EOF
$(roster_lines)
EOF
    if [ "$json" -eq 1 ]; then
      printf '%s' "$all_json" | python3 -c '
import json, sys
rows = [json.loads(line) for line in sys.stdin if line.strip()]
json.dump(rows, sys.stdout, separators=(",", ":"), ensure_ascii=False)
sys.stdout.write("\n")
'
      return 0
    fi
    if [ "$n" -eq 0 ]; then
      printf 'no reachable peers\n'
    fi
    return 0
  fi
  send_one "$from" "$to" "$flags" "$body"
}

resolve_spawn_cwd() {
  local explicit="${1:-}" pane="$2"
  if [ -n "$explicit" ]; then
    [ -d "$explicit" ] || die "spawn: --cwd is not a directory: $explicit"
    (cd "$explicit" && pwd)
    return
  fi
  if [ -n "${PWD:-}" ] && [ -d "$PWD" ]; then
    printf '%s' "$PWD"
    return
  fi
  pane_fmt "$pane" '#{pane_current_path}'
}

abs_dir() {
  (cd "$1" 2>/dev/null && pwd -P) || return 1
}

# Warn on stderr when a live registered worker already sits in $1 (same
# physical path, including a git worktree). Roots and ghosts do not warn.
# Cwd collision is not a spawn error.
warn_occupied_spawn_cwd() {
  local want="$1" want_real line name parent kind cwd cmd other_real names=""
  want_real="$(abs_dir "$want")" || return 0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    parent="$(printf '%s\n' "$line" | field 4)"
    [ -n "$parent" ] || continue
    kind="$(printf '%s\n' "$line" | field 5)"
    cwd="$(printf '%s\n' "$line" | field 7)"
    cmd="$(printf '%s\n' "$line" | field 8)"
    [ -n "$cwd" ] || continue
    [ "$(pane_status "$kind" "$cwd" "$cmd")" = "live" ] || continue
    other_real="$(abs_dir "$cwd")" || continue
    [ "$other_real" = "$want_real" ] || continue
    name="$(printf '%s\n' "$line" | field 2)"
    [ -n "$name" ] || continue
    if [ -n "$names" ]; then
      names="$names, $name"
    else
      names="$name"
    fi
  done <<EOF
$(roster_lines)
EOF
  [ -n "$names" ] || return 0
  printf 'muxa: warning: cwd %s already has live worker %s\n' "$want" "$names" >&2
}

cmd_spawn() {
  need_tmux
  local pane name kind new_window=0 parent id cwd cwd_flag="" sess quoted child cmdpath
  local explicit_cmd=0 cmd arg
  pane="$(this_pane)"
  parent="$(pane_fmt "$pane" '#{@muxa_name}')"
  [ -n "$parent" ] || die "spawn: register this pane first"
  name=""
  kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --kind) kind="$2"; shift 2 ;;
      --cwd) cwd_flag="$2"; shift 2 ;;
      --split) shift ;; # compat: split into the parent window is the default
      --window) new_window=1; shift ;;
      --) explicit_cmd=1; shift; break ;;
      -*) die "spawn: unknown flag $1" ;;
      *) break ;;
    esac
  done
  # Fail closed: muxa flags after the command word are passed to the child today.
  if [ "$explicit_cmd" -eq 0 ] && [ $# -gt 1 ]; then
    cmd="$1"
    shift
    for arg in "$@"; do
      case "$arg" in
        --) break ;;
        --name|--kind|--cwd|--split|--window)
          die "spawn: $arg must precede the command (use: muxa spawn --name NAME --cwd DIR -- COMMAND…)"
          ;;
      esac
    done
    set -- "$cmd" "$@"
  fi
  [ $# -ge 1 ] || die "spawn: command required (muxa spawn --name worker -- cmd…)"
  id="$(new_muxa_id)"
  if [ -n "$name" ]; then
    name="$(sanitize_name "$name")"
  else
    name="$(generate_unique_name "")"
  fi
  [ -n "$kind" ] || kind="$(kind_from_command "$1")"
  if name_taken_by_other "$name" ""; then
    die "name '$name' already registered"
  fi
  cwd="$(resolve_spawn_cwd "$cwd_flag" "$pane")"
  [ -n "$cwd" ] || die "spawn: could not resolve a start directory"
  warn_occupied_spawn_cwd "$cwd"
  sess="$(pane_fmt "$pane" '#{session_name}')"
  quoted="$(shlex_join "$@")"
  cmdpath="$(command -v muxa 2>/dev/null || true)"
  [ -n "$cmdpath" ] || cmdpath="muxa"
  local envcmd
  envcmd="export PATH=$(shlex_join "$(dirname "$cmdpath"):${PATH}") MUXA_NAME=$(shlex_join "$name") MUXA_PARENT=$(shlex_join "$parent") MUXA_ID=$(shlex_join "$id")"
  if [ -n "${MUXA_HOOK_LOG:-}" ]; then
    envcmd="$envcmd MUXA_HOOK_LOG=$(shlex_join "$MUXA_HOOK_LOG")"
  fi
  if [ -n "${MUXA_BIN:-}" ]; then
    envcmd="$envcmd MUXA_BIN=$(shlex_join "$MUXA_BIN")"
  fi
  local spawn_tmux="tmux"
  if [ -n "${MUXA_TMUX_SOCKET:-}" ]; then
    envcmd="$envcmd MUXA_TMUX_SOCKET=$(shlex_join "$MUXA_TMUX_SOCKET")"
    spawn_tmux="tmux -L $(shlex_join "$MUXA_TMUX_SOCKET")"
  fi
  # Ensure spawned agents never stall on workspace trust prompts.
  # - cursor: --trust bypasses the workspace trust dialog.
  # - claude: do not append -p/--print; in Claude Code 2.1.x that is
  #   non-interactive print mode and exits without a prompt (muxa#29).
  # - pi/omp: has no trust gate; no modification needed.
  case "$kind" in
    cursor)
      case " $quoted " in
        *" --trust "*) ;;
        *) quoted="$(printf '%s --trust' "$quoted")" ;;
      esac
      ;;
  esac
  envcmd="$envcmd; $spawn_tmux set-window-option remain-on-exit on 2>/dev/null || true; exec $quoted"
  if [ "$new_window" -eq 1 ]; then
    child="$(tmux_do new-window -t "$sess" -n "$name" -c "$cwd" -P -F '#{pane_id}' "$envcmd")"
  else
    local n cols target winid
    n="$(tmux_do list-panes -t "$pane" -F '#{pane_id}' | awk 'END { print NR }')"
    [ -n "$n" ] || n=1
    cols="$(ceil_sqrt $((n + 1)))"
    target="$(grid_split_target "$pane")"
    [ -n "$target" ] || target="$pane"
    # Complete rectangle (n divisible by next-grid cols) → new row; else add a column.
    if [ $((n % cols)) -eq 0 ]; then
      child="$(tmux_do split-window -v -t "$target" -c "$cwd" -P -F '#{pane_id}' "$envcmd")"
    else
      child="$(tmux_do split-window -h -t "$target" -c "$cwd" -P -F '#{pane_id}' "$envcmd")"
    fi
    winid="$(pane_fmt "$pane" '#{window_id}')"
    tmux_do select-layout -t "$winid" tiled
  fi
  [ -n "$child" ] || die "spawn: tmux did not return a pane id"
  child_win="$(pane_fmt "$child" '#{session_name}:#{window_index}')"
  tmux_do set-window-option -t "$child_win" remain-on-exit on 2>/dev/null || true
  set_pane_opt "$child" @muxa_name "$name"
  set_pane_opt "$child" @muxa_id "$id"
  set_pane_opt "$child" @muxa_parent "$parent"
  set_pane_opt "$child" @muxa_kind "$kind"
  set_pane_title "$child" "$name"
  printf 'spawned %s id=%s parent=%s kind=%s pane=%s cwd=%s\n' "$name" "$id" "$parent" "$kind" "$child" "$cwd"
}

hook_register_pane() {
  local pane="$1" kind="$2"
  local saved="${TMUX_PANE:-}"
  TMUX_PANE="$pane"
  if [ -n "${MUXA_NAME:-}" ] && [ -n "${MUXA_PARENT:-}" ]; then
    cmd_register --name "$MUXA_NAME" --kind "$kind" --parent "$MUXA_PARENT" >/dev/null
  elif [ -n "${MUXA_NAME:-}" ]; then
    cmd_register --name "$MUXA_NAME" --kind "$kind" >/dev/null
  elif [ -n "${MUXA_PARENT:-}" ]; then
    cmd_register --kind "$kind" --parent "$MUXA_PARENT" >/dev/null
  else
    cmd_register --kind "$kind" >/dev/null
  fi
  if [ -n "$saved" ]; then
    TMUX_PANE="$saved"
  else
    unset TMUX_PANE
  fi
}

# Optional root self-registration. Spawned panes are already registered by
# spawn; TMUX_PANE is enough — no stdin payload, no resolution ladder.
# Leftover presence events (busy/idle/blocked/stop/session-end) no-op so
# previously merged per-CLI hooks do not fail closed on upgrade.
cmd_hook() {
  need_tmux
  local event="${1:-}"
  shift || true
  local kind="" pane
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind) kind="$2"; shift 2 ;;
      --format) shift 2 ;;
      *) shift ;;
    esac
  done
  if [ ! -t 0 ]; then
    cat >/dev/null
  fi
  case "$event" in
    session-start|SessionStart|sessionStart) event="session-start" ;;
    session-end|SessionEnd|sessionEnd|busy|PreToolUse|preToolUse|blocked|PermissionRequest|idle|afterAgentResponse|stop|Stop|session_stop)
      return 0
      ;;
    "") die "hook: event required" ;;
    *) die "hook: unknown event $event" ;;
  esac
  pane="$(this_pane)"
  pane_is_registered "$pane" && return 0
  [ -n "$kind" ] || kind="$(detect_kind "$pane")"
  hook_register_pane "$pane" "$kind"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    -h|--help|help) usage ;;
    version|-v|--version) printf '%s\n' "$VERSION" ;;
    register) cmd_register "$@" ;;
    spawn) cmd_spawn "$@" ;;
    who|ls|roster) cmd_who "$@" ;;
    tail) cmd_tail "$@" ;;
    unregister) cmd_unregister "$@" ;;
    whoami) cmd_whoami "$@" ;;
    id) cmd_id "$@" ;;
    session) cmd_session "$@" ;;
    parent) cmd_parent "$@" ;;
    children) cmd_children "$@" ;;
    send) cmd_send "$@" ;;
    broker) cmd_broker "$@" ;;
    hook) cmd_hook "$@" ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
