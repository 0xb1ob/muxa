#!/usr/bin/env bash
# muxa — tmux-native messaging for AI agent CLIs.
# bash 3.2+ (macOS / Linux). Requires tmux. python3 used for JSON and spawn quoting.
set -euo pipefail

VERSION=0.2.2
TMUX_BIN="${MUXA_TMUX_BIN:-tmux}"
ENTER_DELAY="${MUXA_ENTER_DELAY:-0.15}"
INJECT_MAX="${MUXA_INJECT_MAX:-8192}"

usage() {
  cat <<'EOF'
muxa — message other AI CLIs in this tmux server

  muxa register [--name NAME] [--id ID] [--parent NAME] [--kind claude|cursor|pi|generic] [--deliver hook|inject]
  muxa spawn [--name NAME] [--kind KIND] [--cwd DIR] [--split] [--window] -- COMMAND...
                                omit --name to get a unique adjective-noun alias (swift-oak)
                                default: split into a tiled grid in this window (--window for a new window)
                                child cwd: --cwd, else process PWD, else this pane's path
  muxa who                          roster (tmux pane options, CLI session id, cwd, STATUS)
  muxa whoami                       this pane's alias
  muxa unregister NAME|ID           clear muxa registration; leave pane running
  muxa id                           this pane's unique muxa id
  muxa session                      this pane's CLI session/conversation id (empty until reported)
  muxa parent                       this pane's parent alias (empty if root)
  muxa children                     direct children of this pane
  muxa send [--no-reply] NAME TEXT  queue + deliver (parent↔child only)
  muxa send --all TEXT              every parent/child pane (not siblings or other roots)
  muxa peek [NAME]                  unread mail
  muxa deliver [NAME]               claim + inject now (escape hatch)
  muxa state idle|busy|blocked      presence (hooks call this)
  muxa hook EVENT [--format FMT] [--kind KIND]
  muxa version

Orchestrator helpers (git only, no tmux):

  muxa preflight [--base BRANCH] [WORKTREE...]
                                repo checks before handing out jobs: the primary
                                checkout sits on BRANCH (default: origin/HEAD,
                                else main) and each WORKTREE is a linked worktree
                                of this repo. exit 0 all ok, 1 any failure
  muxa jobs add JOB kind=ship|research delivery=pr|local|pipeline [worker=..]
                [worktree=..] [branch=..] [note=..]
  muxa jobs set JOB key=value...    keys: kind delivery worker worktree branch
                                    status pr note
  muxa jobs done JOB [pr=URL]       mark done
  muxa jobs list                    backlog table (status: open running blocked
                                    done dropped)
                                one TSV per project under
                                $XDG_STATE_HOME/muxa/jobs, so an orchestrator
                                restart is a reconcile, not a memory test

Reachability: a parent may message its children; a child may message its
parent. Children cannot message each other. Roots (no parent) cannot
message other roots. muxa send --all follows the same rule.

Agents send with Bash. Incoming mail arrives as a user turn.
Do not poll an inbox. Do not add MCP tools.
EOF
}

die() { printf 'muxa: %s\n' "$*" >&2; exit 2; }
forbid() { printf 'muxa: %s\n' "$*" >&2; exit 4; }

need_tmux() {
  [ -n "${TMUX:-}" ] || [ -n "${MUXA_TMUX_SOCKET:-}" ] || { printf 'muxa: not in tmux (hard requirement)\n' >&2; exit 3; }
}

tmux_do() {
  if [ -n "${MUXA_TMUX_SOCKET:-}" ]; then
    "$TMUX_BIN" -L "$MUXA_TMUX_SOCKET" "$@"
  else
    "$TMUX_BIN" "$@"
  fi
}

consume_stdin() {
  if [ ! -t 0 ]; then
    cat >/dev/null
  fi
}

runtime_root() {
  local base pid
  base="${XDG_RUNTIME_DIR:-/tmp/muxa-${UID:-$(id -u)}}"
  pid="$(tmux_do list-sessions -F '#{pid}' 2>/dev/null | head -1)"
  [ -n "$pid" ] || pid=0
  printf '%s/muxa/%s' "$base" "$pid"
}

mail_box() {
  printf '%s/mail/%s' "$(runtime_root)" "$1"
}

ensure_box() {
  local box
  box="$(mail_box "$1")"
  mkdir -p "$box/tmp" "$box/new" "$box/cur"
  printf '%s' "$box"
}

this_pane() {
  if [ -n "${TMUX_PANE:-}" ]; then
    printf '%s' "$TMUX_PANE"
    return
  fi
  tmux_do display-message -p '#{pane_id}' 2>/dev/null || die "cannot detect pane; set TMUX_PANE"
}

pane_fmt() {
  tmux_do display-message -t "$1" -p "$2" 2>/dev/null || true
}

# ceil(sqrt(n)) for a positive integer. Used to size the next grid.
ceil_sqrt() {
  local n="$1" i=1
  [ "$n" -gt 0 ] || { printf '1'; return; }
  while [ $((i * i)) -lt "$n" ]; do
    i=$((i + 1))
  done
  printf '%s' "$i"
}

# Largest pane (by area, then rightmost) in the last row of the window
# containing $1. Last row = maximum #{pane_top}.
grid_split_target() {
  local win="$1" id top left w h area
  local max_top=-1 best_id="" best_area=-1 best_left=-1
  while read -r id top left w h; do
    [ -n "$id" ] && [ -n "$top" ] && [ -n "$left" ] && [ -n "$w" ] && [ -n "$h" ] || continue
    area=$((w * h))
    if [ "$top" -gt "$max_top" ]; then
      max_top=$top
      best_id=$id
      best_area=$area
      best_left=$left
    elif [ "$top" -eq "$max_top" ]; then
      if [ "$area" -gt "$best_area" ] || { [ "$area" -eq "$best_area" ] && [ "$left" -gt "$best_left" ]; }; then
        best_id=$id
        best_area=$area
        best_left=$left
      fi
    fi
  done <<EOF
$(tmux_do list-panes -t "$win" -F '#{pane_id} #{pane_top} #{pane_left} #{pane_width} #{pane_height}')
EOF
  printf '%s' "$best_id"
}

set_pane_opt() {
  tmux_do set-option -p -t "$1" "$2" "$3"
}

unset_pane_opt() {
  tmux_do set-option -p -t "$1" -u "$2" 2>/dev/null || true
}

new_muxa_id() {
  python3 -c 'import uuid; print(uuid.uuid4().hex[:12])'
}

# pane_id  name  id  parent  kind  state  deliver  where  session  cwd  command
roster_lines() {
  tmux_do list-panes -a -F $'#{pane_id}\t#{@muxa_name}\t#{@muxa_id}\t#{@muxa_parent}\t#{@muxa_kind}\t#{@muxa_state}\t#{@muxa_deliver}\t#{session_name}:#{window_index}.#{pane_index}\t#{@muxa_session}\t#{pane_current_path}\t#{pane_current_command}' 2>/dev/null \
    | awk -F '\t' '$2 != "" { print }'
}

is_shell_command() {
  local base
  base="$(basename "$1")"
  case "$base" in
    zsh|bash|fish|sh|dash|ksh) return 0 ;;
    *) return 1 ;;
  esac
}

pane_status() {
  local kind="$1" cwd="$2" cmd="$3"
  if [ -n "$cwd" ] && [ ! -d "$cwd" ]; then
    printf 'ghost'
    return
  fi
  case "$kind" in
    claude|cursor|pi)
      if is_shell_command "$cmd"; then
        printf 'ghost'
        return
      fi
      ;;
  esac
  printf 'live'
}

clear_muxa_registration() {
  local pane="$1"
  unset_pane_opt "$pane" @muxa_name
  unset_pane_opt "$pane" @muxa_id
  unset_pane_opt "$pane" @muxa_parent
  unset_pane_opt "$pane" @muxa_kind
  unset_pane_opt "$pane" @muxa_state
  unset_pane_opt "$pane" @muxa_deliver
  unset_pane_opt "$pane" @muxa_session
  set_pane_title "$pane" ""
}

find_pane_by_target() {
  local target="$1" line
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 2)" = "$target" ] || continue
    printf '%s' "$(printf '%s\n' "$line" | field 1)"
    return 0
  done <<EOF
$(roster_lines)
EOF
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 3)" = "$target" ] || continue
    printf '%s' "$(printf '%s\n' "$line" | field 1)"
    return 0
  done <<EOF
$(roster_lines)
EOF
  return 1
}

field() {
  awk -F '\t' -v n="$1" '{ print $n }'
}

find_pane_by_name() {
  local name="$1" line
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 2)" = "$name" ] || continue
    printf '%s' "$(printf '%s\n' "$line" | field 1)"
    return 0
  done <<EOF
$(roster_lines)
EOF
  return 1
}

name_parent() {
  local pane
  pane="$(find_pane_by_name "$1")" || { printf ''; return 0; }
  pane_fmt "$pane" '#{@muxa_parent}'
}

name_taken_by_other() {
  local name="$1" self="$2" line pane
  while IFS= read -r line; do
    [ "$(printf '%s\n' "$line" | field 2)" = "$name" ] || continue
    pane="$(printf '%s\n' "$line" | field 1)"
    if [ "$pane" != "$self" ]; then
      return 0
    fi
  done <<EOF
$(roster_lines)
EOF
  return 1
}

# Parent may talk to its children. Child may talk to its parent.
# Children cannot talk to each other. Roots cannot talk to other roots.
can_send() {
  local from="$1" to="$2"
  local from_parent to_parent
  [ -n "$from" ] && [ -n "$to" ] || return 1
  [ "$from" != "$to" ] || return 1
  from_parent="$(name_parent "$from")"
  to_parent="$(name_parent "$to")"
  if [ "$to_parent" = "$from" ]; then
    return 0
  fi
  if [ "$from_parent" = "$to" ]; then
    return 0
  fi
  return 1
}

detect_kind() {
  local cmd
  cmd="$(pane_fmt "$1" '#{pane_current_command}')"
  case "$cmd" in
    claude*) printf 'claude' ;;
    agent|cursor-agent) printf 'cursor' ;;
    omp|pi) printf 'pi' ;;
    *) printf 'generic' ;;
  esac
}

kind_from_command() {
  case "$1" in
    *claude*) printf 'claude' ;;
    *cursor-agent*) printf 'cursor' ;;
    */agent|*agent) printf 'cursor' ;;
    *omp*) printf 'pi' ;;
    *) printf 'generic' ;;
  esac
}

default_deliver() {
  case "$1" in
    claude|cursor|pi) printf 'hook' ;;
    *) printf 'inject' ;;
  esac
}

sanitize_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'
}

# Two-syllable-ish words; pairs pass sanitize_name and are easy to say/type.
MUXA_NAME_ADJECTIVES='amber azure bold brave bright calm crisp eager fair gentle golden keen lively lucid lunar merry noble proud quiet rustic silent silver solar sturdy swift vivid'
MUXA_NAME_NOUNS='badger brook canyon cedar comet ember falcon fern fox glacier grove harbor hawk heron lark maple meadow oak otter pebble pine raven ridge river sparrow stone willow wolf'

word_from_list() {
  local list="$1" n i idx=0 w
  # shellcheck disable=SC2086
  set -- $list
  n=$#
  [ "$n" -gt 0 ] || return 1
  i=$((RANDOM % n))
  for w in "$@"; do
    if [ "$idx" -eq "$i" ]; then
      printf '%s' "$w"
      return 0
    fi
    idx=$((idx + 1))
  done
}

# Unique adjective-noun for this tmux roster. $1 = pane to ignore (self), if any.
generate_unique_name() {
  local self="${1:-}" tries=0 adj noun candidate suffix
  while [ "$tries" -lt 64 ]; do
    adj="$(word_from_list "$MUXA_NAME_ADJECTIVES")"
    noun="$(word_from_list "$MUXA_NAME_NOUNS")"
    candidate="$(sanitize_name "$adj-$noun")"
    if [ -n "$candidate" ] && ! name_taken_by_other "$candidate" "$self"; then
      printf '%s' "$candidate"
      return 0
    fi
    tries=$((tries + 1))
  done
  adj="$(word_from_list "$MUXA_NAME_ADJECTIVES")"
  noun="$(word_from_list "$MUXA_NAME_NOUNS")"
  suffix=2
  candidate="$(sanitize_name "$adj-$noun-$suffix")"
  while name_taken_by_other "$candidate" "$self"; do
    suffix=$((suffix + 1))
    candidate="$(sanitize_name "$adj-$noun-$suffix")"
  done
  printf '%s' "$candidate"
}

set_pane_title() {
  tmux_do select-pane -t "$1" -T "$2" 2>/dev/null || true
}

apply_cli_session() {
  local pane="$1" sid="$2" name short
  [ -n "$sid" ] || return 0
  set_pane_opt "$pane" @muxa_session "$sid"
  name="$(pane_fmt "$pane" '#{@muxa_name}')"
  short="$(printf '%s' "$sid" | cut -c1-8)"
  if [ -n "$name" ]; then
    set_pane_title "$pane" "$name · $short"
  fi
}

read_session_id_from_stdin() {
  if [ -t 0 ]; then
    return 0
  fi
  python3 -c '
import json, sys
raw = sys.stdin.read()
if not raw.strip():
    sys.exit(0)
try:
    data = json.loads(raw)
except Exception:
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)
for key in ("session_id", "sessionId", "conversation_id"):
    val = data.get(key)
    if val is None:
        continue
    text = str(val).strip()
    if text:
        print(text)
        break
' 2>/dev/null || true
}

default_name() {
  local pane="$1" existing
  if [ -n "${MUXA_NAME:-}" ]; then
    sanitize_name "$MUXA_NAME"
    return
  fi
  existing="$(pane_fmt "$pane" '#{@muxa_name}')"
  if [ -n "$existing" ]; then
    printf '%s' "$existing"
    return
  fi
  generate_unique_name "$pane"
}

parent_would_cycle() {
  local child="$1" parent="$2" walk
  [ -n "$parent" ] || return 1
  [ "$child" != "$parent" ] || return 0
  walk="$parent"
  while [ -n "$walk" ]; do
    [ "$walk" != "$child" ] || return 0
    walk="$(name_parent "$walk")"
  done
  return 1
}

json_out() {
  python3 -c '
import json, sys
text = sys.stdin.read()
fmt = sys.argv[1]
if fmt == "claude":
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "Stop",
            "additionalContext": text,
        }
    }))
elif fmt == "cursor":
    print(json.dumps({"followup_message": text}))
elif fmt == "pi":
    print(json.dumps({"continue": True, "additionalContext": text}))
else:
    raise SystemExit(1)
' "$1"
}

shlex_join() {
  python3 -c 'import shlex, sys; print(shlex.join(sys.argv[1:]))' "$@"
}

format_one() {
  local from="$1" flags="$2" body="$3"
  printf '[muxa] from=%s\n' "$from"
  printf '%s\n' "$body"
  case " $flags " in
    *" no-reply "*) printf 'Do not reply.\n' ;;
    *) printf 'Reply: muxa send %s "…"  (skip acks unless asked)\n' "$from" ;;
  esac
}

parse_header() {
  awk -v k="$2" '
    BEGIN { FS=": " }
    /^$/ { exit }
    $1==k { sub(/^[^:]+: /,""); print; exit }
  ' "$1"
}

parse_body() {
  awk 'found { print; next } /^$/ { found=1 }' "$1"
}

write_mail() {
  local from="$1" to="$2" flags="$3" body="$4"
  local box id tmp
  box="$(ensure_box "$to")"
  id="$(date +%s)-$$-$RANDOM"
  tmp="$box/tmp/$id"
  {
    printf 'From: %s\n' "$from"
    printf 'To: %s\n' "$to"
    printf 'Id: %s\n' "$id"
    printf 'Time: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'Flags: %s\n' "$flags"
    printf '\n'
    printf '%s' "$body"
    printf '\n'
  } >"$tmp"
  mv "$tmp" "$box/new/$id"
  printf '%s' "$id"
}

claim_new() {
  local name="$1"
  local box f base
  box="$(ensure_box "$name")"
  for f in "$box/new"/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    mv "$f" "$box/cur/$base" 2>/dev/null || continue
    printf '%s\n' "$box/cur/$base"
  done
}

unclaim_list() {
  local list="$1" f base box
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    base="$(basename "$f")"
    box="$(dirname "$(dirname "$f")")"
    mv "$f" "$box/new/$base" 2>/dev/null || true
  done <"$list"
}

payload_from_claimed() {
  local list="$1"
  local f from flags body n
  n=0
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    n=$((n + 1))
  done <"$list"
  [ "$n" -gt 0 ] || return 1
  if [ "$n" -gt 1 ]; then
    printf '[muxa] %s messages\n\n' "$n"
  fi
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    from="$(parse_header "$f" From)"
    flags="$(parse_header "$f" Flags)"
    body="$(parse_body "$f")"
    if [ "$n" -gt 1 ]; then
      printf -- '-- from=%s id=%s\n' "$from" "$(parse_header "$f" Id)"
    fi
    format_one "$from" "$flags" "$body"
    printf '\n'
  done <"$list"
}

inject_text() {
  local pane="$1" text="$2"
  local buf
  buf="muxa-$$-$RANDOM"
  printf '%s' "$text" | tmux_do load-buffer -b "$buf" -
  tmux_do paste-buffer -p -d -b "$buf" -t "$pane"
  sleep "$ENTER_DELAY"
  tmux_do send-keys -t "$pane" Enter
}

deliver_list() {
  local pane="$1" list="$2"
  local text
  text="$(payload_from_claimed "$list")" || { unclaim_list "$list"; return 1; }
  if [ "${#text}" -gt "$INJECT_MAX" ]; then
    printf 'muxa: body %s bytes exceeds inject limit (%s); left in mailbox\n' "${#text}" "$INJECT_MAX" >&2
    unclaim_list "$list"
    return 1
  fi
  if ! inject_text "$pane" "$text"; then
    unclaim_list "$list"
    return 1
  fi
  set_pane_opt "$pane" @muxa_state busy
}

cmd_register() {
  need_tmux
  local pane name kind deliver parent id
  pane="$(this_pane)"
  name=""
  kind=""
  deliver=""
  parent=""
  id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --kind) kind="$2"; shift 2 ;;
      --deliver) deliver="$2"; shift 2 ;;
      --parent) parent="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      *) die "register: unknown arg $1" ;;
    esac
  done
  [ -n "$name" ] || name="$(default_name "$pane")"
  [ -n "$name" ] || die "could not derive a name; pass --name"
  [ -n "$kind" ] || kind="$(detect_kind "$pane")"
  [ -n "$deliver" ] || deliver="$(default_deliver "$kind")"
  [ -n "$parent" ] || parent="${MUXA_PARENT:-}"
  [ -n "$parent" ] || parent="$(pane_fmt "$pane" '#{@muxa_parent}')"
  [ -n "$id" ] || id="${MUXA_ID:-}"
  [ -n "$id" ] || id="$(pane_fmt "$pane" '#{@muxa_id}')"
  [ -n "$id" ] || id="$(new_muxa_id)"
  case "$kind" in claude|cursor|pi|generic) ;; *) die "bad kind $kind" ;; esac
  case "$deliver" in hook|inject) ;; *) die "bad deliver $deliver" ;; esac
  if name_taken_by_other "$name" "$pane"; then
    die "name '$name' already registered on another pane"
  fi
  if [ -n "$parent" ]; then
    if [ "$parent" = "$name" ]; then
      die "parent cannot be self"
    fi
    find_pane_by_name "$parent" >/dev/null || die "unknown parent '$parent'"
    if parent_would_cycle "$name" "$parent"; then
      die "parent '$parent' would create a cycle"
    fi
  fi
  set_pane_opt "$pane" @muxa_name "$name"
  set_pane_opt "$pane" @muxa_id "$id"
  set_pane_opt "$pane" @muxa_kind "$kind"
  set_pane_opt "$pane" @muxa_deliver "$deliver"
  set_pane_opt "$pane" @muxa_state idle
  if [ -n "$parent" ]; then
    set_pane_opt "$pane" @muxa_parent "$parent"
  else
    unset_pane_opt "$pane" @muxa_parent
  fi
  ensure_box "$name" >/dev/null
  set_pane_title "$pane" "$name"
  if [ -n "$parent" ]; then
    printf 'registered %s id=%s parent=%s kind=%s deliver=%s pane=%s\n' \
      "$name" "$id" "$parent" "$kind" "$deliver" "$pane"
  else
    printf 'registered %s id=%s parent=- kind=%s deliver=%s pane=%s\n' \
      "$name" "$id" "$kind" "$deliver" "$pane"
  fi
}

cmd_who() {
  need_tmux
  printf '%-16s %-14s %-36s %-16s %-8s %-8s %-8s %-8s %-8s %-16s %s\n' \
    NAME ID SESSION PARENT KIND STATE STATUS DELIVER PANE WHERE CWD
  local line kind cwd cmd status
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    kind="$(printf '%s\n' "$line" | field 5)"
    cwd="$(printf '%s\n' "$line" | field 10)"
    cmd="$(printf '%s\n' "$line" | field 11)"
    status="$(pane_status "$kind" "$cwd" "$cmd")"
    printf '%-16s %-14s %-36s %-16s %-8s %-8s %-8s %-8s %-8s %-16s %s\n' \
      "$(printf '%s\n' "$line" | field 2)" \
      "$(printf '%s\n' "$line" | field 3)" \
      "$(printf '%s\n' "$line" | field 9)" \
      "$(printf '%s\n' "$line" | field 4)" \
      "$kind" \
      "$(printf '%s\n' "$line" | field 6)" \
      "$status" \
      "$(printf '%s\n' "$line" | field 7)" \
      "$(printf '%s\n' "$line" | field 1)" \
      "$(printf '%s\n' "$line" | field 8)" \
      "$cwd"
  done <<EOF
$(roster_lines)
EOF
}

cmd_unregister() {
  need_tmux
  local target="${1:-}" pane name id
  [ -n "$target" ] || die "unregister: NAME or ID required"
  pane="$(find_pane_by_target "$target")" || die "unknown agent '$target' — muxa who"
  name="$(pane_fmt "$pane" '#{@muxa_name}')"
  id="$(pane_fmt "$pane" '#{@muxa_id}')"
  clear_muxa_registration "$pane"
  printf 'unregistered %s id=%s pane=%s\n' "$name" "$id" "$pane"
}

cmd_whoami() {
  need_tmux
  local n
  n="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$n" ] || die "this pane is not registered (muxa register)"
  printf '%s\n' "$n"
}

cmd_id() {
  need_tmux
  local n
  n="$(pane_fmt "$(this_pane)" '#{@muxa_id}')"
  [ -n "$n" ] || die "this pane is not registered (muxa register)"
  printf '%s\n' "$n"
}

cmd_session() {
  need_tmux
  printf '%s\n' "$(pane_fmt "$(this_pane)" '#{@muxa_session}')"
}

cmd_parent() {
  need_tmux
  printf '%s\n' "$(pane_fmt "$(this_pane)" '#{@muxa_parent}')"
}

cmd_children() {
  need_tmux
  local me line
  me="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$me" ] || die "this pane is not registered (muxa register)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "$(printf '%s\n' "$line" | field 4)" = "$me" ]; then
      printf '%s\n' "$(printf '%s\n' "$line" | field 2)"
    fi
  done <<EOF
$(roster_lines)
EOF
}

cmd_state() {
  need_tmux
  local st="${1:-}"
  case "$st" in
    idle|busy|blocked) ;;
    *) die "state must be idle|busy|blocked" ;;
  esac
  set_pane_opt "$(this_pane)" @muxa_state "$st"
}

cmd_peek() {
  need_tmux
  local name="${1:-}" box f found from
  from="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$name" ] || name="$from"
  [ -n "$name" ] || die "pass a name or register this pane"
  if [ "$name" != "$from" ]; then
    can_send "$from" "$name" || forbid "cannot peek '$name' (not parent/child)"
  fi
  box="$(ensure_box "$name")"
  found=0
  for f in "$box/new"/*; do
    [ -f "$f" ] || continue
    found=1
    printf '%s\n' "--- $(basename "$f")"
    cat "$f"
    printf '\n'
  done
  [ "$found" -eq 1 ] || printf '(empty)\n'
}

lock_acquire() {
  local dir="$1" i=0 tries="${2:-50}"
  while [ "$i" -lt "$tries" ]; do
    if mkdir "$dir" 2>/dev/null; then
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

lock_release() {
  rmdir "$1" 2>/dev/null || true
}

kick_wait_lock() {
  printf '%s/kick-wait-deliver-%s.lock' "$(runtime_root)" "$1"
}

spawn_kick_wait() {
  local pane="$1" name="$2"
  local runtime lock pidfile
  runtime="$(runtime_root)"
  mkdir -p "$runtime"
  lock="$runtime/kick-wait-spawn-${pane}.lock"
  pidfile="$runtime/kick-wait-${pane}.pid"
  if ! lock_acquire "$lock" 10; then
    return 0
  fi
  if [ -f "$pidfile" ]; then
    if kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
      lock_release "$lock"
      return 0
    fi
  fi
  (
    kick_wait "$pane" "$name"
    rm -f "$pidfile"
  ) >/dev/null 2>&1 &
  printf '%s' "$!" >"$pidfile"
  lock_release "$lock"
}

kick_wait() {
  local pane="$1" name="$2"
  local i state list lock
  i=0
  list="$(runtime_root)/wait-$$-$RANDOM.list"
  lock="$(kick_wait_lock "$pane")"
  mkdir -p "$(runtime_root)"
  while [ "$i" -lt 120 ]; do
    state="$(pane_fmt "$pane" '#{@muxa_state}')"
    if [ "$state" = "idle" ] || [ -z "$state" ]; then
      if lock_acquire "$lock" 100; then
        state="$(pane_fmt "$pane" '#{@muxa_state}')"
        if [ "$state" = "idle" ] || [ -z "$state" ]; then
          claim_new "$name" >"$list" || true
          if [ -s "$list" ]; then
            set_pane_opt "$pane" @muxa_state busy
            deliver_list "$pane" "$list" || true
          fi
        fi
        lock_release "$lock"
      fi
      rm -f "$list"
      return 0
    fi
    sleep 0.5
    i=$((i + 1))
  done
  rm -f "$list"
}

send_one() {
  local from="$1" to="$2" flags="$3" body="$4"
  local pane state deliver id list
  if [ "$to" = "$from" ]; then
    return 0
  fi
  pane="$(find_pane_by_name "$to")" || die "unknown agent '$to' — muxa who"
  can_send "$from" "$to" || forbid "forbidden $from → $to (only parent↔child)"
  id="$(write_mail "$from" "$to" "$flags" "$body")"
  state="$(pane_fmt "$pane" '#{@muxa_state}')"
  deliver="$(pane_fmt "$pane" '#{@muxa_deliver}')"
  case "$state" in
    busy|blocked)
      if [ "$deliver" = "inject" ]; then
        spawn_kick_wait "$pane" "$to"
        printf 'queued %s → %s id=%s (waiting for idle)\n' "$from" "$to" "$id"
      else
        printf 'queued %s → %s id=%s (hook will drain)\n' "$from" "$to" "$id"
      fi
      ;;
    *)
      list="$(runtime_root)/send-$$-$RANDOM.list"
      mkdir -p "$(runtime_root)"
      claim_new "$to" >"$list" || true
      if [ -s "$list" ] && deliver_list "$pane" "$list"; then
        printf 'delivered %s → %s id=%s\n' "$from" "$to" "$id"
      else
        printf 'queued %s → %s id=%s\n' "$from" "$to" "$id"
      fi
      rm -f "$list"
      ;;
  esac
}

cmd_send() {
  need_tmux
  local no_reply=0 all=0 to="" body="" from flags line dest n
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-reply) no_reply=1; shift ;;
      --all) all=1; shift ;;
      --) shift; break ;;
      -*) die "send: unknown flag $1" ;;
      *) break ;;
    esac
  done
  if [ "$all" -eq 0 ]; then
    [ $# -ge 1 ] || die "send: NAME required"
    to="$1"
    shift
  fi
  if [ $# -gt 0 ]; then
    body="$*"
  else
    body="$(cat)"
  fi
  [ -n "$body" ] || die "send: empty body"
  from="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$from" ] || from="${MUXA_NAME:-human}"
  flags=""
  [ "$no_reply" -eq 1 ] && flags="no-reply"

  if [ "$all" -eq 1 ]; then
    n=0
    seen=$'\n'
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      dest="$(printf '%s\n' "$line" | field 2)"
      [ -n "$dest" ] || continue
      case "$seen" in
        *$'\n'"$dest"$'\n'*) continue ;;
      esac
      can_send "$from" "$dest" || continue
      seen="${seen}${dest}"$'\n'
      send_one "$from" "$dest" "$flags" "$body"
      n=$((n + 1))
    done <<EOF
$(roster_lines)
EOF
    if [ "$n" -eq 0 ]; then
      printf 'no reachable peers\n'
    fi
    return 0
  fi
  send_one "$from" "$to" "$flags" "$body"
}

cmd_deliver() {
  need_tmux
  local name="${1:-}" pane list from
  from="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
  [ -n "$name" ] || name="$from"
  [ -n "$name" ] || die "pass a name"
  if [ -n "$from" ] && [ "$name" != "$from" ]; then
    can_send "$from" "$name" || forbid "cannot deliver to '$name'"
  fi
  pane="$(find_pane_by_name "$name")" || die "unknown agent '$name'"
  list="$(runtime_root)/deliver-$$.list"
  mkdir -p "$(runtime_root)"
  claim_new "$name" >"$list" || true
  if [ ! -s "$list" ]; then
    rm -f "$list"
    printf 'no mail\n'
    return 0
  fi
  deliver_list "$pane" "$list"
  printf 'injected into %s\n' "$name"
  rm -f "$list"
}

# Child start directory: --cwd, else the muxa process $PWD, else the
# parent pane path. $PWD is what Cursor (subprocess shell) and "cd && muxa
# spawn" actually control; #{pane_current_path} is the tmux pane, which
# often stays at the parent's project.
resolve_spawn_cwd() {
  local explicit="${1:-}" pane="$2"
  if [ -n "$explicit" ]; then
    [ -d "$explicit" ] || die "spawn: --cwd is not a directory: $explicit"
    (cd "$explicit" && pwd)
    return
  fi
  if [ -n "${PWD:-}" ] && [ -d "$PWD" ]; then
    printf '%s' "$PWD"
    return
  fi
  pane_fmt "$pane" '#{pane_current_path}'
}

cmd_spawn() {
  need_tmux
  local pane name kind new_window=0 parent id cwd cwd_flag="" sess quoted child cmdpath
  pane="$(this_pane)"
  parent="$(pane_fmt "$pane" '#{@muxa_name}')"
  [ -n "$parent" ] || die "spawn: register this pane first"
  name=""
  kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --kind) kind="$2"; shift 2 ;;
      --cwd) cwd_flag="$2"; shift 2 ;;
      --split) shift ;; # compat: split into the parent window is the default
      --window) new_window=1; shift ;;
      --) shift; break ;;
      -*) die "spawn: unknown flag $1" ;;
      *) break ;;
    esac
  done
  [ $# -ge 1 ] || die "spawn: command required (muxa spawn --name worker -- cmd…)"
  id="$(new_muxa_id)"
  if [ -n "$name" ]; then
    name="$(sanitize_name "$name")"
  else
    name="$(generate_unique_name "")"
  fi
  [ -n "$kind" ] || kind="$(kind_from_command "$1")"
  if name_taken_by_other "$name" ""; then
    die "name '$name' already registered"
  fi
  cwd="$(resolve_spawn_cwd "$cwd_flag" "$pane")"
  [ -n "$cwd" ] || die "spawn: could not resolve a start directory"
  sess="$(pane_fmt "$pane" '#{session_name}')"
  quoted="$(shlex_join "$@")"
  cmdpath="$(command -v muxa 2>/dev/null || true)"
  [ -n "$cmdpath" ] || cmdpath="muxa"
  local envcmd
  envcmd="export PATH=$(shlex_join "$(dirname "$cmdpath"):${PATH}") MUXA_NAME=$(shlex_join "$name") MUXA_PARENT=$(shlex_join "$parent") MUXA_ID=$(shlex_join "$id")"
  if [ -n "${MUXA_HOOK_LOG:-}" ]; then
    envcmd="$envcmd MUXA_HOOK_LOG=$(shlex_join "$MUXA_HOOK_LOG")"
  fi
  if [ -n "${MUXA_BIN:-}" ]; then
    envcmd="$envcmd MUXA_BIN=$(shlex_join "$MUXA_BIN")"
  fi
  envcmd="$envcmd; exec $quoted"
  if [ "$new_window" -eq 1 ]; then
    child="$(tmux_do new-window -t "$sess" -n "$name" -c "$cwd" -P -F '#{pane_id}' "$envcmd")"
  else
    local n cols target winid
    n="$(tmux_do list-panes -t "$pane" -F '#{pane_id}' | awk 'END { print NR }')"
    [ -n "$n" ] || n=1
    cols="$(ceil_sqrt $((n + 1)))"
    target="$(grid_split_target "$pane")"
    [ -n "$target" ] || target="$pane"
    # Complete rectangle (n divisible by next-grid cols) → new row; else add a column.
    if [ $((n % cols)) -eq 0 ]; then
      child="$(tmux_do split-window -v -t "$target" -c "$cwd" -P -F '#{pane_id}' "$envcmd")"
    else
      child="$(tmux_do split-window -h -t "$target" -c "$cwd" -P -F '#{pane_id}' "$envcmd")"
    fi
    winid="$(pane_fmt "$pane" '#{window_id}')"
    tmux_do select-layout -t "$winid" tiled
  fi
  [ -n "$child" ] || die "spawn: tmux did not return a pane id"
  set_pane_opt "$child" @muxa_name "$name"
  set_pane_opt "$child" @muxa_id "$id"
  set_pane_opt "$child" @muxa_parent "$parent"
  set_pane_opt "$child" @muxa_kind "$kind"
  set_pane_opt "$child" @muxa_deliver "$(default_deliver "$kind")"
  set_pane_opt "$child" @muxa_state idle
  ensure_box "$name" >/dev/null
  set_pane_title "$child" "$name"
  printf 'spawned %s id=%s parent=%s kind=%s pane=%s cwd=%s\n' "$name" "$id" "$parent" "$kind" "$child" "$cwd"
}

cmd_hook() {
  need_tmux
  local event="${1:-}"
  shift || true
  local format="claude" kind="" session_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) format="$2"; shift 2 ;;
      --kind) kind="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  case "$event" in
    session-start|SessionStart|sessionStart)
      session_id="$(read_session_id_from_stdin)"
      [ -n "$kind" ] || kind="$(detect_kind "$(this_pane)")"
      if [ -n "${MUXA_NAME:-}" ] && [ -n "${MUXA_PARENT:-}" ]; then
        cmd_register --name "$MUXA_NAME" --kind "$kind" --deliver hook --parent "$MUXA_PARENT" >/dev/null
      elif [ -n "${MUXA_NAME:-}" ]; then
        cmd_register --name "$MUXA_NAME" --kind "$kind" --deliver hook >/dev/null
      elif [ -n "${MUXA_PARENT:-}" ]; then
        cmd_register --kind "$kind" --deliver hook --parent "$MUXA_PARENT" >/dev/null
      else
        cmd_register --kind "$kind" --deliver hook >/dev/null
      fi
      if [ -n "$session_id" ]; then
        apply_cli_session "$(this_pane)" "$session_id"
      fi
      cmd_state idle
      ;;
    session-end|SessionEnd|sessionEnd)
      consume_stdin
      clear_muxa_registration "$(this_pane)"
      ;;
    busy|PreToolUse|preToolUse)
      consume_stdin
      cmd_state busy
      ;;
    blocked|PermissionRequest)
      consume_stdin
      cmd_state blocked
      ;;
    idle)
      consume_stdin
      cmd_state idle
      ;;
    stop|Stop|session_stop)
      consume_stdin
      local name list payload
      name="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
      if [ -z "$name" ]; then
        [ -n "$kind" ] || kind="$(detect_kind "$(this_pane)")"
        cmd_register --kind "$kind" --deliver hook >/dev/null
        name="$(pane_fmt "$(this_pane)" '#{@muxa_name}')"
      fi
      list="$(runtime_root)/hook-$$.list"
      mkdir -p "$(runtime_root)"
      claim_new "$name" >"$list" || true
      if [ ! -s "$list" ]; then
        rm -f "$list"
        cmd_state idle
        return 0
      fi
      cmd_state busy
      payload="$(payload_from_claimed "$list")"
      rm -f "$list"
      printf '%s' "$payload" | json_out "$format"
      ;;
    *)
      consume_stdin
      die "hook: unknown event $event"
      ;;
  esac
}

# --- preflight: git-only repo checks (no tmux) ------------------------------

abs_dir() {
  (cd "$1" 2>/dev/null && pwd -P) || return 1
}

# Absolute .git dir shared by every worktree of a repo. Two paths belong to the
# same repo when this matches.
git_common_dir() {
  local dir="$1" g
  g="$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null)" || return 1
  [ -n "$g" ] || return 1
  case "$g" in
    /*) abs_dir "$g" ;;
    *) abs_dir "$dir/$g" ;;
  esac
}

# git lists the main worktree first.
primary_worktree() {
  git -C "$1" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{ sub(/^worktree /, ""); print; exit }'
}

default_base_branch() {
  local ref
  ref="$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  case "$ref" in
    origin/*) printf '%s' "${ref#origin/}" ;;
    *) printf 'main' ;;
  esac
}

PREFLIGHT_FAIL=0
pf_ok() { printf 'ok   %s\n' "$*"; }
pf_fail() { printf 'fail %s\n' "$*"; PREFLIGHT_FAIL=1; }

cmd_preflight() {
  local base="" repo common primary branch arg wt wt_common
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) [ $# -ge 2 ] || die "preflight: --base needs a branch"; base="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "preflight: unknown flag $1" ;;
      *) break ;;
    esac
  done
  PREFLIGHT_FAIL=0
  repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$repo" ]; then
    pf_fail "repo $PWD is not a git repository"
    return 1
  fi
  repo="$(abs_dir "$repo")"
  common="$(git_common_dir "$repo" || true)"
  [ -n "$common" ] || { pf_fail "repo $repo has no resolvable git dir"; return 1; }
  pf_ok "repo $repo"

  [ -n "$base" ] || base="$(default_base_branch "$repo")"
  pf_ok "base branch $base"

  # The orchestrator must not sit on a branch a worker needs to build on.
  primary="$(primary_worktree "$repo")"
  if [ -z "$primary" ]; then
    pf_fail "primary checkout: git worktree list returned nothing"
    primary=""
  elif [ ! -d "$primary" ]; then
    pf_fail "primary $primary does not exist"
  else
    primary="$(abs_dir "$primary")"
    branch="$(git -C "$primary" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    if [ -z "$branch" ]; then
      pf_fail "primary $primary is detached (want $base)"
    elif [ "$branch" = "$base" ]; then
      pf_ok "primary $primary on $base"
    else
      pf_fail "primary $primary on $branch (want $base)"
    fi
  fi

  for arg in "$@"; do
    if [ ! -d "$arg" ]; then
      pf_fail "worktree $arg does not exist"
      continue
    fi
    wt="$(abs_dir "$arg")"
    wt_common="$(git_common_dir "$wt" || true)"
    if [ -z "$wt_common" ]; then
      pf_fail "worktree $wt is not a git worktree"
    elif [ "$wt_common" != "$common" ]; then
      pf_fail "worktree $wt belongs to another repo ($wt_common)"
    elif [ -n "$primary" ] && [ "$wt" = "$primary" ]; then
      pf_fail "worktree $wt is the primary checkout, not a linked worktree"
    else
      branch="$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || printf 'detached')"
      pf_ok "worktree $wt linked on $branch"
    fi
  done

  [ "$PREFLIGHT_FAIL" -eq 0 ] || return 1
}

# --- jobs: on-disk backlog per project (no tmux) ----------------------------
# job kind delivery worker worktree branch status pr note updated
JOBS_HEADER=$'#job\tkind\tdelivery\tworker\tworktree\tbranch\tstatus\tpr\tnote\tupdated'

jobs_project_key() {
  local top
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$top" ] || top="$PWD"
  abs_dir "$top" || printf '%s' "$top"
}

# One TSV per project, keyed by git toplevel realpath: survives tmux restarts,
# agent restarts and worktree churn.
jobs_file() {
  local key slug hash
  key="$(jobs_project_key)"
  slug="$(sanitize_name "$(basename "$key")" | sed 's/^\.*//')"
  [ -n "$slug" ] || slug="repo"
  hash="$(printf '%s' "$key" | python3 -c 'import hashlib, sys; print(hashlib.sha1(sys.stdin.buffer.read()).hexdigest()[:8])')"
  printf '%s/muxa/jobs/%s-%s.tsv' "${XDG_STATE_HOME:-$HOME/.local/state}" "$slug" "$hash"
}

jobs_ensure_file() {
  mkdir -p "$(dirname "$1")"
  [ -f "$1" ] || printf '%s\n' "$JOBS_HEADER" >"$1"
}

# One TSV cell: no tabs, no newlines, empty renders as -
jobs_clean() {
  local v
  v="$(printf '%s' "$1" | tr '\t\n' '  ')"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  [ -n "$v" ] || v='-'
  printf '%s' "$v"
}

jobs_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

jobs_check_name() {
  case "$1" in
    "" | '#'*) die "jobs: bad job name '$1'" ;;
    *[[:space:]]*) die "jobs: job name must not contain whitespace: '$1'" ;;
  esac
}

jobs_check_kind() {
  case "$1" in ship|research) ;; *) die "jobs: bad kind '$1' (ship|research)" ;; esac
}

jobs_check_delivery() {
  case "$1" in pr|local|pipeline) ;; *) die "jobs: bad delivery '$1' (pr|local|pipeline)" ;; esac
}

jobs_check_status() {
  case "$1" in
    open|running|blocked|done|dropped) ;;
    *) die "jobs: bad status '$1' (open|running|blocked|done|dropped)" ;;
  esac
}

jobs_row() {
  MUXA_JOB_KEY="$2" awk -F '\t' '$1 == ENVIRON["MUXA_JOB_KEY"] { print; exit }' "$1"
}

jobs_replace_row() {
  local file="$1" tmp
  tmp="$file.tmp.$$"
  MUXA_JOB_KEY="$2" MUXA_JOB_ROW="$3" \
    awk -F '\t' '$1 == ENVIRON["MUXA_JOB_KEY"] { print ENVIRON["MUXA_JOB_ROW"]; next } { print }' \
    "$file" >"$tmp"
  mv "$tmp" "$file"
}

jobs_lock() {
  lock_acquire "$1.lock" 50 || die "jobs: could not lock $1"
}

# jobs_apply FILE JOB key=value... — validate, then rewrite the row in place.
jobs_apply() {
  local file="$1" job="$2"
  shift 2
  local pair key val row lock
  local f_job f_kind f_delivery f_worker f_worktree f_branch f_status f_pr f_note f_updated
  [ $# -ge 1 ] || die "jobs: key=value required"
  for pair in "$@"; do
    case "$pair" in *=*) ;; *) die "jobs: expected key=value, got '$pair'" ;; esac
    key="${pair%%=*}"
    val="${pair#*=}"
    case "$key" in
      kind) jobs_check_kind "$val" ;;
      delivery) jobs_check_delivery "$val" ;;
      status) jobs_check_status "$val" ;;
      worker|worktree|branch|pr|note) ;;
      *) die "jobs: unknown key '$key'" ;;
    esac
  done
  lock="$file"
  jobs_lock "$lock"
  row="$(jobs_row "$file" "$job")"
  if [ -z "$row" ]; then
    lock_release "$lock.lock"
    die "jobs: unknown job '$job' — muxa jobs list"
  fi
  IFS=$'\t' read -r f_job f_kind f_delivery f_worker f_worktree f_branch f_status f_pr f_note f_updated <<EOF
$row
EOF
  for pair in "$@"; do
    key="${pair%%=*}"
    val="$(jobs_clean "${pair#*=}")"
    case "$key" in
      kind) f_kind="$val" ;;
      delivery) f_delivery="$val" ;;
      worker) f_worker="$val" ;;
      worktree) f_worktree="$val" ;;
      branch) f_branch="$val" ;;
      status) f_status="$val" ;;
      pr) f_pr="$val" ;;
      note) f_note="$val" ;;
    esac
  done
  f_updated="$(jobs_now)"
  jobs_replace_row "$file" "$f_job" \
    "$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
      "$f_job" "$f_kind" "$f_delivery" "$f_worker" "$f_worktree" \
      "$f_branch" "$f_status" "$f_pr" "$f_note" "$f_updated")"
  lock_release "$lock.lock"
}

cmd_jobs_add() {
  local file="$1" job="$2"
  shift 2
  local pair key val lock
  local kind="" delivery="" worker="" worktree="" branch="" note=""
  for pair in "$@"; do
    case "$pair" in *=*) ;; *) die "jobs add: expected key=value, got '$pair'" ;; esac
    key="${pair%%=*}"
    val="${pair#*=}"
    case "$key" in
      kind) kind="$val" ;;
      delivery) delivery="$val" ;;
      worker) worker="$val" ;;
      worktree) worktree="$val" ;;
      branch) branch="$val" ;;
      note) note="$val" ;;
      status|pr) die "jobs add: '$key' is set later (muxa jobs set|done)" ;;
      *) die "jobs add: unknown key '$key'" ;;
    esac
  done
  [ -n "$kind" ] || die "jobs add: kind=ship|research required"
  [ -n "$delivery" ] || die "jobs add: delivery=pr|local|pipeline required"
  jobs_check_kind "$kind"
  jobs_check_delivery "$delivery"
  lock="$file"
  jobs_lock "$lock"
  if [ -n "$(jobs_row "$file" "$job")" ]; then
    lock_release "$lock.lock"
    die "jobs add: job '$job' already exists"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$job" "$kind" "$delivery" "$(jobs_clean "$worker")" "$(jobs_clean "$worktree")" \
    "$(jobs_clean "$branch")" open '-' "$(jobs_clean "$note")" "$(jobs_now)" >>"$file"
  lock_release "$lock.lock"
  printf 'added %s kind=%s delivery=%s status=open\n' "$job" "$kind" "$delivery"
}

cmd_jobs_list() {
  local file="$1" n=0
  local c1 c2 c3 c4 c5 c6 c7 c8 c9 c10
  printf '%-16s %-8s %-9s %-9s %-14s %-22s %-28s %-21s %-32s %s\n' \
    JOB STATUS KIND DELIVERY WORKER BRANCH WORKTREE UPDATED PR NOTE
  while IFS=$'\t' read -r c1 c2 c3 c4 c5 c6 c7 c8 c9 c10; do
    case "$c1" in "" | '#'*) continue ;; esac
    n=$((n + 1))
    printf '%-16s %-8s %-9s %-9s %-14s %-22s %-28s %-21s %-32s %s\n' \
      "$c1" "$c7" "$c2" "$c3" "$c4" "$c6" "$c5" "$c10" "$c8" "$c9"
  done <"$file"
  [ "$n" -gt 0 ] || printf '(no jobs)\n'
}

cmd_jobs() {
  local sub="${1:-}" file job arg
  shift || true
  case "$sub" in
    add|set|done|list) ;;
    "") die "jobs: add|set|done|list required" ;;
    *) die "jobs: unknown subcommand '$sub'" ;;
  esac
  file="$(jobs_file)"
  jobs_ensure_file "$file"
  case "$sub" in
    list)
      [ $# -eq 0 ] || die "jobs list: unexpected argument '$1'"
      cmd_jobs_list "$file"
      ;;
    add)
      [ $# -ge 1 ] || die "jobs add: JOB required"
      job="$1"
      shift
      jobs_check_name "$job"
      cmd_jobs_add "$file" "$job" "$@"
      ;;
    set)
      [ $# -ge 2 ] || die "jobs set: JOB key=value... required"
      job="$1"
      shift
      jobs_check_name "$job"
      jobs_apply "$file" "$job" "$@"
      printf 'updated %s %s\n' "$job" "$*"
      ;;
    done)
      [ $# -ge 1 ] || die "jobs done: JOB [pr=URL] required"
      job="$1"
      shift
      jobs_check_name "$job"
      for arg in "$@"; do
        case "$arg" in pr=*) ;; *) die "jobs done: only pr=URL is accepted, got '$arg'" ;; esac
      done
      jobs_apply "$file" "$job" "$@" status=done
      printf 'done %s\n' "$job"
      ;;
  esac
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    -h|--help|help) usage ;;
    version|-v|--version) printf '%s\n' "$VERSION" ;;
    register) cmd_register "$@" ;;
    spawn) cmd_spawn "$@" ;;
    who|ls|roster) cmd_who "$@" ;;
    unregister) cmd_unregister "$@" ;;
    whoami) cmd_whoami "$@" ;;
    id) cmd_id "$@" ;;
    session) cmd_session "$@" ;;
    parent) cmd_parent "$@" ;;
    children) cmd_children "$@" ;;
    send) cmd_send "$@" ;;
    peek) cmd_peek "$@" ;;
    deliver) cmd_deliver "$@" ;;
    state) cmd_state "$@" ;;
    hook) cmd_hook "$@" ;;
    preflight) cmd_preflight "$@" ;;
    jobs) cmd_jobs "$@" ;;
    kick-wait)
      need_tmux
      kick_wait "$1" "$2"
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
